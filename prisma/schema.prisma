// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  USER
  ADMIN
}

enum SubStatus {
  INACTIVE
  ACTIVE
  EXPIRED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  password      String?   // Facultatif si on utilise uniquement des providers OAuth
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations NextAuth
  accounts      Account[]
  sessions      Session[]
  
  // Business Logic
  subscription  Subscription?
  whatsappBot   WhatsappBot?
}

model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       SubStatus @default(INACTIVE)
  planName     String    // ex: "Standard", "Premium"
  chariowSubId String?   @unique // ID de l'abonnement ou de la transaction côté Chariow
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model WhatsappBot {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber    String?  @unique
  isActive       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Paramètres personnalisables du bot par l'utilisateur
  welcomeMessage  String? @default("Bonjour ! Comment puis-je vous aider ?")
  fallbackMessage String? @default("Désolé, je ne comprends pas votre demande.")

  // Stockage de la session Baileys (Multi-Auth chiffré en DB)
  session WhatsappSession?
}

model WhatsappSession {
  id          String      @id @default(uuid())
  botId       String      @unique
  whatsappBot WhatsappBot @relation(fields: [botId], references: [id], onDelete: Cascade)
  creds       String      // Contenu JSON de "creds" converti en String textuel chiffré
  keys        String      // Contenu JSON de "keys" (états d'auth) converti en String textuel chiffré
  updatedAt   DateTime    @updatedAt
}
